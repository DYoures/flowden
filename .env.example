# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flowden

# Authentication
# Required in production: must be a high-entropy secret of at least 32 bytes (e.g. generated via `openssl rand -hex 32`).
# In development/test, a process-local cryptographically random secret is generated if left unset.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

